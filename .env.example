# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real keys.

# --- Supabase -------------------------------------------------------------
# Safe to expose in the browser (RLS is what protects your data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses Row Level Security entirely. Server-side only.
# Never prefix this with NEXT_PUBLIC_. If it leaks, rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (audio storage) ---------------------------------------
# SECRET. Keep the bucket private; do not set a public bucket URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ieltstar-recordings

# --- Speech to text -------------------------------------------------------
# SECRET.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# --- Feedback model (OpenRouter) -----------------------------------------
# SECRET. Set a hard spend limit on this key in the OpenRouter dashboard.
OPENROUTER_API_KEY=

# NEVER use a model id ending in "-contributor".
#
# Contributor tiers are cheap because the provider uses the prompts to improve
# its products, and our prompts contain students' transcribed speech. Students
# have not consented to that, and many of them are minors. The few cents saved
# are not worth it: the feedback model is roughly 1% of the cost of a session,
# because transcription (Deepgram) dominates the bill.
#
# Also switch OFF "providers that may train on your data" in your OpenRouter
# privacy settings, so a bad model id fails loudly instead of leaking quietly.
#
# Chosen default: generally available (not preview), supports structured JSON
# output, and allows large completions, which a full mock needs.
OPENROUTER_MODEL=google/gemini-3.8-flash

# Reasonable alternatives, all non-training:
#   google/gemini-3-flash-preview  - cheaper, but preview models can be retired
#   z-ai/glm-5.3-flash             - cheapest by far; verify Z.ai's data policy
#   meta/muse-spark-1.3            - the non-contributor tier of Muse Spark

# Only used to identify your app to OpenRouter.
OPENROUTER_SITE_URL=https://ieltstar.online
