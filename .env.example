# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real keys.

# --- Supabase -------------------------------------------------------------
# Safe to expose in the browser (RLS is what protects your data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses Row Level Security entirely. Server-side only.
# Never prefix this with NEXT_PUBLIC_. If it leaks, rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (audio storage) ---------------------------------------
# SECRET. Keep the bucket private; do not set a public bucket URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ieltstar-recordings

# --- Speech to text -------------------------------------------------------
# SECRET.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# --- Feedback model -------------------------------------------------------
# SECRET. Set a hard spend limit on this key in the provider dashboard.
OPENROUTER_API_KEY=

# Gateway base URL. Any OpenAI-compatible chat-completions endpoint works.
# Leave blank to use OpenRouter. Must be HTTPS: student transcripts travel
# over this connection, and the client refuses plain HTTP.
#
# Whichever gateway you point this at can read every prompt, which means every
# student's transcribed speech. Before switching to a reseller or discount
# gateway, confirm in writing that it does not retain or train on requests.
# A cheaper price is not worth an unknown data policy.
#   OpenRouter:  https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# NEVER use a model id ending in "-contributor".
#
# Contributor tiers are cheap because the provider uses the prompts to improve
# its products, and our prompts contain students' transcribed speech. Students
# have not consented to that, and many of them are minors. The few cents saved
# are not worth it: the feedback model is roughly 1% of the cost of a session,
# because transcription (Deepgram) dominates the bill.
#
# Also switch OFF "providers that may train on your data" in your gateway's
# privacy settings, so a bad model id fails loudly instead of leaking quietly.
#
# Chosen default: flagship-class reasoning, generally available (not preview),
# and allows large completions, which a full mock needs. Band judgements have
# to stay consistent across four criteria and up to 20 answers in one JSON
# object, which is where a stronger reasoning model earns its keep.
OPENROUTER_MODEL=x-ai/grok-4.6

# Reasonable alternatives, all non-training:
#   z-ai/glm-5.3-flash    - cheapest credible option; verify Z.ai's data policy
#   openai/gpt-5.6-luna   - solid and cheap, but a tier below flagship reasoning
#   google/gemini-3.8-flash - strong structured-output support, pricier
#   meta/muse-spark-1.3   - the non-contributor tier of Muse Spark
#
# If you change this, re-run one full mock end to end before trusting it. The
# analysis route requires ONE strict JSON object; a model that ignores json
# mode will fail schema validation after you have already paid for Deepgram.

# Only used to identify your app to the gateway.
OPENROUTER_SITE_URL=https://ieltstar.online
